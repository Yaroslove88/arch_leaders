{
  "name": "@leadership-architect/api",
  "version": "1.0.0",
  "description": "Backend API for Leadership Architect",
  "main": "dist/apps/api/src/main.js",
  "types": "dist/apps/api/src/main.d.ts",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/apps/api/src/main.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "kill-port": "powershell -ExecutionPolicy Bypass -File ../../KILL_PORT.ps1",
    "migrate:quests": "tsx ../../scripts/migrate-quests.ts",
    "migrate:sessions": "tsx ../../scripts/migrate-sessions.ts",
    "migrate:quests-structure": "tsx scripts/migrate-quests-structure.ts",
    "update-quest-theories": "node ../../scripts/update-quest-theories.js",
    "script:delete-in-person-quests": "tsx src/scripts/delete-all-in-person-quests.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage"
  },
  "dependencies": {
    "@leadership-architect/shared": "workspace:*",
    "@nestjs/common": "^10.2.0",
    "@nestjs/config": "^3.1.0",
    "@nestjs/core": "^10.2.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^10.2.0",
    "@nestjs/schedule": "^6.1.0",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^5.7.0",
    "@sentry/nestjs": "^10.32.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "dotenv": "^17.2.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.11.3",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.2.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^11.1.11",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.0.0",
    "@types/passport-jwt": "^4.0.1",
    "eslint": "^8.50.0",
    "jest": "^29.7.0",
    "prisma": "^5.7.0",
    "ts-jest": "^29.4.6",
    "tsx": "^4.21.0",
    "typescript": "^5.2.0"
  }
}
