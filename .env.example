# ============================================
# Leadership Architect - Environment Variables
# ============================================
# РЎРєРѕРїРёСЂСѓР№С‚Рµ СЌС‚РѕС‚ С„Р°Р№Р» РІ .env Рё Р·Р°РїРѕР»РЅРёС‚Рµ Р·РЅР°С‡РµРЅРёСЏ
# cp .env.example .env
# РёР»Рё РІ Windows PowerShell:
# Copy-Item .env.example .env

# ============================================
# Database Configuration
# ============================================
# PostgreSQL connection string
# Р¤РѕСЂРјР°С‚: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://leadership_architect:YOUR_PASSWORD@localhost:5433/leadership_architect?schema=public"

# Р”Р»СЏ Docker Compose (РёСЃРїРѕР»СЊР·СѓРµС‚СЃСЏ РІ infra/docker-compose.dev.yml)
POSTGRES_USER=leadership_architect
POSTGRES_PASSWORD=CHANGE_THIS_PASSWORD
POSTGRES_DB=leadership_architect
POSTGRES_PORT=5433

# ============================================
# API Configuration
# ============================================
# РџРѕСЂС‚ РґР»СЏ API СЃРµСЂРІРµСЂР°
PORT=3001

# РћРєСЂСѓР¶РµРЅРёРµ: development, production, test
NODE_ENV=development

# URL С„СЂРѕРЅС‚РµРЅРґ РїСЂРёР»РѕР¶РµРЅРёСЏ (РґР»СЏ CORS)
WEB_URL=http://localhost:3000

# РћРїС†РёРѕРЅР°Р»СЊРЅС‹Р№ API РєР»СЋС‡ РґР»СЏ Р·Р°С‰РёС‚С‹ endpoints
# Р•СЃР»Рё РЅРµ СѓСЃС‚Р°РЅРѕРІР»РµРЅ, API Р±СѓРґРµС‚ РґРѕСЃС‚СѓРїРµРЅ Р±РµР· Р°СѓС‚РµРЅС‚РёС„РёРєР°С†РёРё
API_KEY=

# ============================================
# LLM Configuration
# ============================================
# OpenAI API Key (РёСЃРїРѕР»СЊР·СѓРµС‚СЃСЏ РґР»СЏ Р°РЅР°Р»РёР·Р° СЃРёС‚СѓР°С†РёР№)
# РџРѕР»СѓС‡РёС‚СЊ РјРѕР¶РЅРѕ РЅР°: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic API Key (Р°Р»СЊС‚РµСЂРЅР°С‚РёРІР° OpenAI)
# РџРѕР»СѓС‡РёС‚СЊ РјРѕР¶РЅРѕ РЅР°: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ============================================
# Authentication (JWT)
# ============================================
# Secret key for JWT tokens (generate with: openssl rand -hex 32)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
# Token expiration in seconds (default: 7 days = 604800)
JWT_EXPIRES_IN=604800

# ============================================
# Telegram Bot Configuration (optional)
# ============================================
# Token from @BotFather
TELEGRAM_BOT_TOKEN=

# Chat ID for notifications
TELEGRAM_CHAT_ID=

# ============================================
# Tree Sync Configuration
# ============================================
# Disable auto-sync from seed file (RECOMMENDED for production)
# When true, seed updates won't overwrite TreeSemantic.data automatically
# Set to 'true' to prevent accidental data loss
DISABLE_TREE_AUTO_SYNC=true

# ============================================
# Security Notes
# ============================================
# вљ пёЏ Р’РђР–РќРћ:
# - РќРёРєРѕРіРґР° РЅРµ РєРѕРјРјРёС‚СЊС‚Рµ .env С„Р°Р№Р» РІ git
# - РСЃРїРѕР»СЊР·СѓР№С‚Рµ СЃРёР»СЊРЅС‹Рµ РїР°СЂРѕР»Рё РґР»СЏ production
# - Р РµРіСѓР»СЏСЂРЅРѕ СЂРѕС‚РёСЂСѓР№С‚Рµ API РєР»СЋС‡Рё
# - Р’ production РёСЃРїРѕР»СЊР·СѓР№С‚Рµ СЃРµРєСЂРµС‚С‹ РёР· Р±РµР·РѕРїР°СЃРЅРѕРіРѕ С…СЂР°РЅРёР»РёС‰Р°
#   (AWS Secrets Manager, HashiCorp Vault, etc.)
