{
  "name": "leadership-architect",
  "version": "1.0.0",
  "description": "Архитектор лидерства - Life-RPG для развития лидерских способностей",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@leadership-architect/api",
    "dev:web": "turbo run dev --filter=@leadership-architect/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run lint typecheck test --parallel",
    "clean": "turbo run clean && npx rimraf node_modules",
    "fresh": "pnpm clean && pnpm install && pnpm db:generate",
    "db:generate": "cd apps/api && pnpm prisma generate",
    "db:migrate": "cd apps/api && pnpm prisma migrate dev",
    "db:reset": "cd apps/api && pnpm prisma migrate reset --force",
    "db:studio": "cd apps/api && pnpm prisma studio",
    "db:push": "cd apps/api && pnpm prisma db push",
    "turbo:login": "turbo login",
    "turbo:link": "turbo link",
    "validate-seed": "tsx scripts/migrate-seed.ts",
    "fix-base-layout": "tsx scripts/fix-base-layout.ts",
    "check:quality": "tsx scripts/check-code-quality.ts",
    "check:swagger": "tsx scripts/fix-swagger-decorators.ts",
    "migrate:experience": "cd apps/api && npx tsx scripts/migrate-experience-system.ts",
    "precommit": "pnpm check:quality && pnpm lint && pnpm typecheck",
    "convert:cases": "node scripts/convert-cases-yaml-to-json-v2.js",
    "verify:cases": "node scripts/verify-cases.js"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "eslint": "^8.50.0",
    "prettier": "^3.0.0",
    "shadcn": "^3.7.0",
    "tsx": "^4.21.0",
    "turbo": "^2.3.0",
    "typescript": "^5.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@10.26.2",
  "browserslist": [
    ">0.3%",
    "not dead",
    "not op_mini all",
    "last 2 chrome versions",
    "last 2 firefox versions",
    "last 2 safari versions",
    "last 2 edge versions"
  ]
}
